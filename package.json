{
  "name": "@kira905/dsh-session-title-live",
  "version": "0.2.6",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "AGPL-3.0-only",
  "description": "Live session-title provider for dsh: regenerates the session title after EVERY user message (automatic: \"all-prompts\"), summarizing the most recent messages within a byte budget. Zero dependencies.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session-title",
    "cordis",
    "dsh-plugin"
  ],
  "files": [
    "lib",
    "examples",
    "cordis.patch.yml",
    "cordis.patch.yml.example",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "verify": "node scripts/verify-source.mjs .",
    "test": "node scripts/verify-source.mjs . && node _test/test-mark.mjs && node _test/test-self-schedule.mjs && node _test/test-kill-switch.mjs",
    "test:e2e": "node scripts/test-e2e.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kira905/dsh-session-title-live.git"
  },
  "homepage": "https://github.com/kira905/dsh-session-title-live#readme",
  "bugs": {
    "url": "https://github.com/kira905/dsh-session-title-live/issues"
  }
}
